CONFIG_ESPTOOLPY_BAUD=921600
CONFIG_MONITOR_BAUD=115200

## Default sample settings for esp32-mini-scope
## These can be overridden in menuconfig under "Component config → mini scope"
CONFIG_MINI_SCOPE_SAMPLE_RATE=200000
CONFIG_MINI_SCOPE_FRAME_SAMPLES=1024

## Enable ADC calibration API (optional)
CONFIG_ADC_CAL_EFUSE_TP_ENABLE=y
CONFIG_ADC_CAL_EFUSE_VREF_ENABLE=y